// 1. Métricas de disponibilidad, conexiones y bloqueos en Azure SQL Database
AzureMetrics
| where ResourceProvider == "MICROSOFT.SQL"
| where MetricName in ("availability", "connection_failed", "blocked_by_firewall", "deadlock")
| summarize Promedio = avg(Average), Total = sum(Total) by MetricName, bin(TimeGenerated, 1h)
| order by TimeGenerated desc

// 2. Trabajos de Azure Backup en Recovery Services Vault (usa JobDurationInSecs)
AddonAzureBackupJobs
| where TimeGenerated > ago(24h)
| project TimeGenerated, BackupItemUniqueId, JobOperation, JobStatus, JobDurationInSecs
| order by TimeGenerated desc

// 3. Logs de diagnóstico y auditoría (Key Vault, SQL y Storage) en Log Analytics
AzureDiagnostics
| where TimeGenerated > ago(24h)
| where ResourceProvider in ("MICROSOFT.KEYVAULT", "MICROSOFT.SQL", "MICROSOFT.STORAGE")
| project TimeGenerated, ResourceProvider, Resource, OperationName, ResultType
| order by TimeGenerated desc

// 4. Operaciones de administración y failover de SQL Failover Groups (Activity Log)
AzureActivity
| where TimeGenerated > ago(24h)
| where _ResourceId contains "failoverGroups" or OperationNameValue contains "FAILOVERGROUPS"
| project TimeGenerated, OperationNameValue, ActivityStatusValue, Caller, _ResourceId
| order by TimeGenerated desc
